# ============================================================
#  Clicuster — пример переменных окружения
#  Скопируйте в .env и при необходимости измените:
#      cp .env.example .env          (Linux/macOS)
#      copy .env.example .env        (Windows)
#
#  ИЗМЕНЕНО 22.11.2026 (аудит/исправления):
#   • SECRET_KEY в примере был «change-me» — с ним приложение просто не
#     стартовало (валидатор требует >= 32 байт). Теперь здесь длинный
#     пример и команда генерации;
#   • добавлены новые настройки: ENABLE_DOCS, ALLOWED_HOSTS,
#     TRUST_PROXY_HEADERS, REDIS_ENABLED, BCRYPT_ROUNDS, лимиты записи;
#   • CORS_ORIGINS — JSON-массив (поддерживается и строка через запятую).
# ============================================================

# ============================================================
#  Application
# ============================================================
APP_NAME=Clicuster
APP_VERSION=0.1.0
# local | dev | prod
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Документация /docs и /redoc (в проде обычно выключают)
ENABLE_DOCS=true

# ============================================================
#  Security
# ============================================================
# Сгенерируйте свой ключ (минимум 32 байта):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_please_generate_a_random_secret_key_at_least_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Стоимость bcrypt: 12 для прода, 4 — для быстрых тестов
BCRYPT_ROUNDS=12

# ============================================================
#  Database (PostgreSQL)
# ============================================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clicuster_db

# Пул соединений
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ============================================================
#  Redis (кеш/очереди; пока не используется — выключен)
# ============================================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================
#  HTTP / CORS
# ============================================================
# JSON-массив или строка через запятую
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Белый список Host (через запятую). Пусто — проверка отключена.
# В проде укажите домены: ALLOWED_HOSTS=clicuster.ru,www.clicuster.ru
ALLOWED_HOSTS=
# Включайте true только если приложение стоит за доверенным прокси
# (nginx/traefik), иначе IP клиента можно подделать.
TRUST_PROXY_HEADERS=false

# ============================================================
#  Rate limiting (защита от подбора пароля)
# ============================================================
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ============================================================
#  Бронирование
# ============================================================
# Сколько минут минимум должно оставаться до начала записи
BOOKING_MIN_LEAD_MINUTES=0
# На сколько дней вперёд можно записаться
BOOKING_HORIZON_DAYS=90
